# ==============================================================================
# .env.example — a TEMPLATE showing every environment variable the app reads.
#
# WHY THIS FILE EXISTS:
#   The real ".env" file holds secrets and is git-ignored (see .gitignore).
#   But a new developer cloning the repo needs to know WHICH variables exist.
#   So we commit this "example" with safe placeholder values. The workflow is:
#       cp .env.example .env        # then edit .env with real values
#
# HOW IT'S LOADED:
#   src/config.py uses pydantic-settings, which automatically reads a file
#   named ".env" and maps each KEY to a field on the Settings class.
# ==============================================================================

# ---- Core app metadata ----
APP_NAME="Tasks API"
APP_VERSION="0.1.0"
# "development" enables verbose errors + auto-reload conveniences.
# In real deployments you'd set this to "production".
ENVIRONMENT="development"

# ---- Database ----
# We default to SQLite so the project runs with ZERO external services.
# The "+aiosqlite" part selects the ASYNC driver (SQLAlchemy needs an async
# driver to work inside async def endpoints).
#
# To switch to PostgreSQL, install a running Postgres and use a URL like:
#   DATABASE_URL="postgresql+asyncpg://postgres:pass@localhost:5432/tasks"
# Nothing else in the code changes — that is the payoff of the async engine layer.
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# Log every SQL statement SQLAlchemy emits. Great for learning ("show me the
# actual query"), noisy in production. Boolean-ish string; pydantic parses it.
DB_ECHO="false"

# ---- Security / JWT ----
# The secret used to SIGN JWTs. If an attacker learns this, they can forge
# tokens and impersonate anyone. MUST be long, random, and secret in prod.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="dev-only-insecure-change-me-please-0123456789abcdef"
# HS256 = HMAC + SHA-256. Symmetric: same secret signs and verifies. Simple and
# fine for a single service. (RS256 uses a public/private keypair — used when a
# separate service must verify tokens without holding the signing secret.)
JWT_ALGORITHM="HS256"
# How long an access token stays valid, in minutes. Short-lived is safer.
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# ---- Redis (optional; used for caching + demonstrating cache patterns) ----
# If Redis is unreachable, the app degrades gracefully (cache simply misses).
REDIS_URL="redis://localhost:6379/0"
# Master switch so you can run without Redis at all.
CACHE_ENABLED="false"

# ---- Rate limiting ----
# Requests allowed per client per window. Applied by slowapi.
RATE_LIMIT="100/minute"

# WHERE THE RATE-LIMIT COUNTERS LIVE — this decides whether RATE_LIMIT above
# actually means what it says.
#
#   "memory://"             counters in this process. Correct for ONE process.
#   "redis://host:6379/1"   counters shared by all processes. Correct for MANY.
#
# ⚠️ WHY IT MATTERS: with "memory://" and 3 replicas there are 3 independent
#    counters, so "100/minute" silently becomes up to 300/minute — and which
#    counter a request increments depends on which replica the load balancer
#    picked, so the effective limit is also non-deterministic. Nothing errors and
#    nothing logs; the limit is simply a lie.
#    Horizontal scaling doesn't create bugs. It reveals the ones you had.
#
# Default is "memory://" so `git clone && pytest` works with no Redis at all —
# defaults should describe the simplest working setup, not the production one.
# Kubernetes overrides it; see k8s/10-configmap.yaml. Note the /1: the cache uses
# logical database 0, so the two keyspaces stay isolated.
RATE_LIMIT_STORAGE_URI="memory://"

# ---- Readiness probe ----
# How long GET /ready waits for the database before reporting 503.
#
# ⚠️ MUST BE LOWER than the readinessProbe's timeoutSeconds in
#    k8s/40-deployment.yaml (3s). An orchestrator abandoning its HTTP request does
#    NOT stop the handler, so an unbounded check would keep holding a database
#    connection — one leaked connection per probe until the pool is empty, at which
#    point the health check has caused the outage it was meant to report.
READINESS_TIMEOUT_SECONDS="2.0"
